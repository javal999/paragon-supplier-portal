{
  "name": "paragon-supplier-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:vercel": "VERCEL=1 vite build",
    "preview:vercel": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:gate": "node --test gate/*.test.js",
    "gates": "node scripts/gates.mjs",
    "drift": "vitest run --config vitest.drift.config.js",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{js,jsx}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@vercel/functions": "^3.7.5",
    "i18next": "^26.3.4",
    "lucide-react": "^1.16.0",
    "react": "^19.3.0",
    "react-datasheet-grid": "^4.11.6",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.2",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "//overrides": "react-resize-detector@7 (pulled in by react-datasheet-grid) declares react-dom ^16-^18 as a peer, so npm nested a second, React 18 copy of react-dom under it, which crashes on React 19. The override makes it share the app's React 19. Remove it once react-datasheet-grid depends on a react-resize-detector that accepts React 19.",
  "overrides": {
    "react-resize-detector": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
